{
  "name": "rakt-pravah-functions",
  "description": "Cloud Functions and Push Notification Backend for Rakt Pravah",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "node server.js",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "node test/matcher.test.js && node test/notifications.test.js && node test/endpoints.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-rakt-rules \"node --test --test-concurrency=1 test/rules/*.test.js\""
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0"
  },
  "private": true,
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0"
  }
}
