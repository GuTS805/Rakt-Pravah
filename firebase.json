{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "hosting": [
    {
      "site": "nobloodlink",
      "public": "hosting_public",
      "ignore": [
        "firebase.json",
        "**/.*"
      ]
    },
    {
      "site": "raktpravah-admin",
      "public": "hosting_admin",
      "ignore": [
        "firebase.json",
        "**/.*"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**/*.@(html|js|json)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    }
  ],
  "emulators": {
    "auth": { "port": 9099 },
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "nobloodlink",
          "appId": "1:458287363105:android:7eb9bdca3deaae52005f60",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "nobloodlink",
          "configurations": {
            "android": "1:458287363105:android:7eb9bdca3deaae52005f60",
            "ios": "1:458287363105:ios:72dfec9ca0b61e30005f60",
            "web": "1:458287363105:web:09a1f9af7fc04b6d005f60"
          }
        }
      }
    }
  }
}
