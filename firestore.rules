rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isParticipant(requestId) {
      let req = get(/databases/$(database)/documents/blood_requests/$(requestId)).data;
      return request.auth.uid == req.requesterId
        || request.auth.uid in req.get('acceptedDonorIds', []);
    }

    // Profile pictures are kept as small base64 text, because Firebase
    // Storage needs a paid plan. The client shrinks them to a few KB; this is
    // the ceiling that stops anyone storing something large in their place.
    function photoOk(photo) {
      return photo == null || (photo is string && photo.size() <= 60000);
    }

    // Whether an account may ask for blood or donate. The operators' switch
    // lives in config/app (off when that document does not exist). While it
    // is on, only approved accounts and operators pass. An account from
    // before approval existed has no approved field and counts as approved.
    function canAct() {
      return !exists(/databases/$(database)/documents/config/app)
        || get(/databases/$(database)/documents/config/app)
             .data.get('requireApproval', false) != true
        || isAdmin()
        || get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.get('approved', true) == true;
    }

    // Operator access for the admin console (spec §27). The flag lives on the
    // user's own profile document, which only an existing admin can set —
    // see the users rule below, which refuses self-promotion.
    function isAdmin() {
      return isSignedIn()
        && (request.auth.token.get('admin', false) == true
            || request.auth.token.get('role', '') == 'admin'
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin');
    }

    // Profile documents. A profile is readable by the person it belongs to
    // and by operators, and by nobody else: it holds a name and a phone
    // number, and the app has no feature that needs to read a stranger's.
    // Names that other people legitimately see (a requester's, an accepted
    // donor's) are copied onto the request itself.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      // Owners write their own profile, but the admin flag and role are not
      // theirs to set — without this split, any user could promote themselves to
      // operator by writing one field to their own document.
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.get('isAdmin', false) == false
        && request.resource.data.get('role', 'user') != 'admin'
        // A new account starts unapproved, and cannot start any other way:
        // leaving the field out would otherwise read as approved.
        && request.resource.data.get('approved', null) == false
        && photoOk(request.resource.data.get('photo', null));

      allow update: if isSignedIn() && (
        (request.auth.uid == uid
          && request.resource.data.get('isAdmin', false)
             == resource.data.get('isAdmin', false)
          && request.resource.data.get('role', 'user')
             == resource.data.get('role', 'user')
          && request.resource.data.get('approved', null)
             == resource.data.get('approved', null)
          && photoOk(request.resource.data.get('photo', null)))
        || (isAdmin()
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['isAdmin', 'role', 'isActive', 'disabled', 'approved']))
      );

      allow delete: if false;
    }

    // Append-only record of operator actions (spec §27). Nobody, including
    // admins, can rewrite history here — that is the whole point of it.
    match /admin_audit/{entryId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false;
    }

    // Abuse reports. Any signed-in user can file one (for the mobile Report
    // screen); only operators can read or resolve them.
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // App-wide settings. Everyone signed in reads them; only operators change
    // them.
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /blood_requests/{requestId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && canAct()
        && request.resource.data.requesterId == request.auth.uid
        && photoOk(request.resource.data.get('requesterPhoto', null));

      // Six, and only six, kinds of update are allowed:
      //  1. the requester changes their own request (cancel, fulfil, etc.)
      //  2. a donor commits to one of the units still open. One donor gives
      //     one unit, so this refuses a donor who is already on the list and
      //     refuses the acceptance that would exceed the units asked for —
      //     the real enforcement, not the client transaction alone.
      //  3. a donor adds themselves to the declined list
      //  4. an accepted donor updates only their own live-location entry
      //     (spec §19 — sharing is opt-in, revocable, and can't touch
      //     anything else on the request, including other donors' entries)
      //  5. an accepted donor withdraws: they come off the list and the
      //     request goes back to searching for that unit
      //  6. an operator removes a request (spec §27 moderation), scoped to
      //     the two fields removal touches, so admin access can't be used to
      //     quietly rewrite someone's request
      allow update: if isSignedIn() && (
        resource.data.requesterId == request.auth.uid
        || (canAct()
            && !(request.auth.uid in resource.data.get('acceptedDonorIds', []))
            && request.auth.uid in request.resource.data.acceptedDonorIds
            && request.resource.data.acceptedDonorIds.size()
               == resource.data.get('acceptedDonorIds', []).size() + 1
            && request.resource.data.acceptedDonorIds.size() <= resource.data.units
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['acceptedDonors', 'acceptedDonorIds', 'status',
                           'timeline']))
        || (request.resource.data.declinedByDonorIds.hasAll(resource.data.declinedByDonorIds)
            && request.auth.uid in request.resource.data.declinedByDonorIds
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['declinedByDonorIds']))
        || (request.auth.uid in resource.data.get('acceptedDonorIds', [])
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['donorLiveLocations'])
            && request.resource.data.get('donorLiveLocations', {})
                 .diff(resource.data.get('donorLiveLocations', {}))
                 .affectedKeys().hasOnly([request.auth.uid]))
        || (request.auth.uid in resource.data.get('acceptedDonorIds', [])
            && !(request.auth.uid in request.resource.data.acceptedDonorIds)
            && request.resource.data.status == 'searching'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['acceptedDonors', 'acceptedDonorIds', 'status',
                           'timeline', 'declinedByDonorIds',
                           'donorLiveLocations']))
        || (isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'timeline'])
            && request.resource.data.status == 'removedByAdmin')
      );

      allow delete: if false;

      // The patient's name. Requests themselves are readable by every signed
      // -in user, because that is how donors find them; this is the part that
      // isn't anyone else's business. Only the requester and the donors who
      // accepted can read it, and only the requester writes it.
      match /private/{docId} {
        allow read: if isSignedIn() && isParticipant(requestId);
        allow create, update: if isSignedIn()
          && get(/databases/$(database)/documents/blood_requests/$(requestId))
               .data.requesterId == request.auth.uid;
        allow delete: if false;
      }

      // Request-scoped private chat — only the requester and the accepted
      // donor can read or send messages (spec §18, §26).
      match /messages/{messageId} {
        allow read: if isSignedIn() && isParticipant(requestId);
        allow create: if isSignedIn() && isParticipant(requestId)
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
