rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isParticipant(requestId) {
      let req = get(/databases/$(database)/documents/blood_requests/$(requestId)).data;
      return request.auth.uid == req.requesterId
        || request.auth.uid in req.get('acceptedDonorIds', []);
    }

    // Operator access for the admin console (spec §27). The flag lives on the
    // user's own profile document, which only an existing admin can set —
    // see the users rule below, which refuses self-promotion.
    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Profile documents. Read is broader than write on purpose: logging in
    // by phone number needs to find an existing profile via a query, and
    // anonymous auth carries no verified phone claim to check against —
    // this is a known, documented tradeoff for a phone-number-only login
    // with no OTP step. Writes are always locked to the owner.
    match /users/{uid} {
      allow read: if isSignedIn();

      // Owners write their own profile, but the admin flag is not theirs to
      // set — without this split, any user could promote themselves to
      // operator by writing one field to their own document.
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.get('isAdmin', false) == false;

      allow update: if isSignedIn() && (
        (request.auth.uid == uid
          && request.resource.data.get('isAdmin', false)
             == resource.data.get('isAdmin', false))
        || (isAdmin()
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['isAdmin']))
      );

      allow delete: if false;
    }

    // Append-only record of operator actions (spec §27). Nobody, including
    // admins, can rewrite history here — that is the whole point of it.
    match /admin_audit/{entryId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false;
    }

    // Abuse reports. Any signed-in user can file one (for the mobile Report
    // screen); only operators can read or resolve them.
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /blood_requests/{requestId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.requesterId == request.auth.uid;

      // Six, and only six, kinds of update are allowed:
      //  1. the requester changes their own request (cancel, fulfil, etc.)
      //  2. a donor commits to one of the units still open. One donor gives
      //     one unit, so this refuses a donor who is already on the list and
      //     refuses the acceptance that would exceed the units asked for —
      //     the real enforcement, not the client transaction alone.
      //  3. a donor adds themselves to the declined list
      //  4. an accepted donor updates only their own live-location entry
      //     (spec §19 — sharing is opt-in, revocable, and can't touch
      //     anything else on the request, including other donors' entries)
      //  5. an accepted donor withdraws: they come off the list and the
      //     request goes back to searching for that unit
      //  6. an operator removes a request (spec §27 moderation), scoped to
      //     the two fields removal touches, so admin access can't be used to
      //     quietly rewrite someone's request
      allow update: if isSignedIn() && (
        resource.data.requesterId == request.auth.uid
        || (!(request.auth.uid in resource.data.get('acceptedDonorIds', []))
            && request.auth.uid in request.resource.data.acceptedDonorIds
            && request.resource.data.acceptedDonorIds.size()
               == resource.data.get('acceptedDonorIds', []).size() + 1
            && request.resource.data.acceptedDonorIds.size() <= resource.data.units
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['acceptedDonors', 'acceptedDonorIds', 'status',
                           'timeline']))
        || (request.resource.data.declinedByDonorIds.hasAll(resource.data.declinedByDonorIds)
            && request.auth.uid in request.resource.data.declinedByDonorIds
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['declinedByDonorIds']))
        || (request.auth.uid in resource.data.get('acceptedDonorIds', [])
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['donorLiveLocations'])
            && request.resource.data.get('donorLiveLocations', {})
                 .diff(resource.data.get('donorLiveLocations', {}))
                 .affectedKeys().hasOnly([request.auth.uid]))
        || (request.auth.uid in resource.data.get('acceptedDonorIds', [])
            && !(request.auth.uid in request.resource.data.acceptedDonorIds)
            && request.resource.data.status == 'searching'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['acceptedDonors', 'acceptedDonorIds', 'status',
                           'timeline', 'declinedByDonorIds',
                           'donorLiveLocations']))
        || (isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'timeline'])
            && request.resource.data.status == 'removedByAdmin')
      );

      allow delete: if false;

      // Request-scoped private chat — only the requester and the accepted
      // donor can read or send messages (spec §18, §26).
      match /messages/{messageId} {
        allow read: if isSignedIn() && isParticipant(requestId);
        allow create: if isSignedIn() && isParticipant(requestId)
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
